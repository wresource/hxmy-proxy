<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 出站上网：代理转发的上行连接走默认网络（通常携带系统 VPN） -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 读取网络状态 / registerDefaultNetworkCallback / NetworkCapabilities -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!--
      本地网络访问（Android 17 / targetSdk 37 day-one 硬门）：**入站 accept 必需**。
      ⚠️ 不要因为「和 mDNS 有关」把它删掉 —— mDNS 已整个移除，而这一条与 mDNS 无关：
      没有它，局域网客户端连不进来，且**静默失败**（不崩、不报错，只是全部连不上）。
      CHANGE_WIFI_MULTICAST_STATE 才是 mDNS 专用的，已随 MdnsPublisher 一并删除。
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- 前台服务：connectedDevice 类型 + 其限定权限（CHANGE_NETWORK_STATE/CHANGE_WIFI_STATE 满足前置） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- 常驻通知（Android 13+ 运行时权限） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 电池优化白名单请求（诊断「电池优化」引导直接弹系统授权框；长时共享防后台冻结间断） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 开机后自动恢复共享（仅当上次在共享中；见 RestartReceiver）。normal 权限，不弹窗。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 电池优化白名单引导（Play 敏感权限，仅用于减少后台被杀） -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />

    <!-- allowBackup=false：DataStore 与日志含用户上网相关配置/记录，隐私政策承诺「完全本地、不上云」。
         换机迁移改由「设置 → 设置备份」手动导出/导入 JSON 承担。 -->
    <application
        android:name=".HxmyProxyApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HxmyProxy">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.HxmyProxy.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 代理前台服务（承载 HTTP/SOCKS5/PAC 监听 + 常驻通知）。详见 version-md/v1-service-permissions-compat.md -->
        <service
            android:name=".service.ProxyForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- 开机 / app 更新后自动恢复共享：两者均在「后台启动前台服务」豁免内，且 connectedDevice
             不在 Android 15 对 BOOT_COMPLETED 启动 FGS 的类型限制清单中。exported 必须为 true（系统广播）。 -->
        <receiver
            android:name=".service.RestartReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 导出日志文件的 FileProvider（share sheet 用 content:// 授权） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
